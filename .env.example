# QA PR Review Agent configuration.
#
# Copy to .env and edit. Every value here is a placeholder - never commit a
# real key. The defaults work with no editing: an embedded SQLite database and
# deterministic (non-AI) analysis.

# ---------------------------------------------------------------------------
# AI provider (optional - the system runs deterministically without one)
# ---------------------------------------------------------------------------
AI_PROVIDER=gemini                 # gemini | claude-cli
AI_FALLBACK_PROVIDER=              # tried only when the primary is unavailable
AI_DISABLED=0                      # 1 forces deterministic analysis
GEMINI_API_KEY=
GEMINI_MODEL=                      # empty = gemini-3.6-flash
GEMINI_FALLBACK_MODELS=

# Claude runs through the locally installed, already logged-in Claude Code CLI.
# No Anthropic API key is used or needed.
CLAUDE_CLI_COMMAND=claude
CLAUDE_MODEL=                      # empty = whatever the CLI is configured to use
CLAUDE_CLI_TIMEOUT_MS=120000
CLAUDE_CLI_EFFORT=                 # low | medium | high | xhigh | max

# Token budgets
AI_MAX_INPUT_CHARS=48000
AI_MAX_OUTPUT_TOKENS=8192
AI_MAX_FILES_PER_REQUEST=8
AI_MAX_TESTS_PER_REQUEST=25
AI_MAX_DIFF_CHARS=20000
AI_CACHE_ENABLED=true

# ---------------------------------------------------------------------------
# Storage
# ---------------------------------------------------------------------------
DATABASE_URL=sqlite:./data/qa-agent.db     # or postgres://user:pass@host:5432/db
WORKSPACE_ROOT=./workspaces
ARTIFACT_ROOT=./artifacts
ARTIFACT_RETENTION_DAYS=30
# 32 bytes of hex; required to store any credential.
# node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
CREDENTIAL_ENCRYPTION_KEY=

# ---------------------------------------------------------------------------
# GitHub
# ---------------------------------------------------------------------------
# A fine-grained token: Contents read, plus Pull requests write to comment.
GITHUB_TOKEN=
GITHUB_APP_ID=
GITHUB_APP_PRIVATE_KEY=
GITHUB_APP_INSTALLATION_ID=
GITHUB_API_URL=                    # set for GitHub Enterprise Server

# ---------------------------------------------------------------------------
# Pull-request review
# ---------------------------------------------------------------------------
# Required to accept webhook deliveries at POST /api/github/webhook.
GITHUB_WEBHOOK_SECRET=
PR_REVIEW_ACTIONS=opened,synchronize,reopened,ready_for_review
# Where the PR's build is served. {number} is the pull request number.
PR_PREVIEW_URL_TEMPLATE=
# Serves the checked-out PR for the review, then stops it. Empty = the
# application is already running at the base URL.
PR_APP_START_COMMAND=
PR_APP_START_TIMEOUT_MS=180000
# Credential-shaped variables (…_SECRET, …_TOKEN, …_KEY, AWS_*, NPM_TOKEN) are
# withheld from the application under test and from the generated suite. Name
# any the application genuinely needs to boot, comma-separated.
PR_APP_ENV_ALLOW=
# Reviewing a fork's pull request builds and serves code written by whoever
# opened it, on this machine. Off by default; the webhook ignores fork PRs.
PR_REVIEW_FORKS=0
# Public URL of this API, so PR comments can link to recordings. The API has no
# authentication of its own: anyone who can reach this URL can read every
# artifact it serves, and a comment on a public pull request publishes the
# links. Put it behind authentication before setting this. Note that a
# Playwright trace of a failed login against a real backend records the test
# credentials, so use throwaway accounts (or PLAYWRIGHT_TRACE=off).
QA_PUBLIC_URL=

# A review signs in and submits forms, so it refuses to test a host that looks
# like production. Local hosts, hosts named like dev/staging/qa/uat/preview
# environments (e.g. dev-admin.example.com) and PR preview hosts are allowed;
# list any other safe host here (comma-separated, "*.example.com" for subdomains).
QA_ALLOWED_TEST_HOSTS=

# Also run the target repository's own Playwright tests that relate to the
# change, with the repository's own config, fixtures and auth setup. They need
# the repository's dependencies installed in the checkout (PR_APP_START_COMMAND
# usually does that); otherwise the report says they could not run.
REPO_TESTS_ENABLED=1
REPO_TESTS_MAX=20

# ---------------------------------------------------------------------------
# Test execution (Playwright)
# ---------------------------------------------------------------------------
TEST_BASE_URL=http://localhost:3000
PLAYWRIGHT_BROWSER=chromium        # chromium | firefox | webkit
PLAYWRIGHT_TIMEOUT_MS=600000       # the whole Playwright run; a timeout keeps the results so far
PLAYWRIGHT_STARTUP_TIMEOUT_MS=120000  # no test began by then: browser/config/compilation hung
PLAYWRIGHT_WORKERS=1               # 0 = let Playwright decide
PLAYWRIGHT_HEADED=0
PLAYWRIGHT_VIDEO=on                # on | off | retain-on-failure | on-first-retry
PLAYWRIGHT_SCREENSHOT=only-on-failure
PLAYWRIGHT_TRACE=retain-on-failure
# 1: generated tests stub the app's API with fixtures built from its own types,
#    and sign-in is simulated (the report says so).
# 0: tests run against the real backend and sign in through the app's own login
#    form with the accounts below; each sign-in is verified and reported.
# Before any test, the review checks whether the affected routes need signing
# in, signs in once, verifies the protected route opens, and shares that session
# with the walkthrough and every test. If it cannot (no credentials, rejected,
# a CAPTCHA), protected tests are not run and the review is BLOCKED.
# Behind a CAPTCHA, sign in once by hand and the session is reused:
#   npm run qa -- auth <project>            (opens a browser)
#   npm run qa -- auth <project> --check --route /some/protected/page
TEST_MOCK_API=1
TEST_USER_EMAIL=
TEST_USER_PASSWORD=
# Where tests sign in, if not where the app redirects. May carry a test-only
# CAPTCHA bypass, e.g. /login?token=...; the query is masked in every report.
TEST_LOGIN_PATH=
TEST_ADMIN_EMAIL=
TEST_ADMIN_PASSWORD=

# Validate static analysis against the running app during ordinary runs.
# A pull-request review always records its walkthrough, whatever this is set to.
BROWSER_EXPLORATION_ENABLED=0

# ---------------------------------------------------------------------------
# Server
# ---------------------------------------------------------------------------
PORT=4000
LOG_LEVEL=info
NODE_ENV=development
